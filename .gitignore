# =========================
# 依赖目录
# =========================
node_modules/
.pnpm-store/
.yarn/
.cache/

# =========================
# VuePress 构建产物
# GitHub Pages 由 gh-pages 分支托管
# 不要提交本地构建结果
# =========================
docs/.vuepress/dist/
docs/.vuepress/.temp/
docs/.vuepress/.cache/

# =========================
# 环境配置文件
# 防止泄露本地配置
# =========================
.env
.env.*
!.env.example

# =========================
# 日志
# =========================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================
# 编辑器 / IDE
# =========================
.vscode/
.idea/
*.swp
*.swo

# =========================
# 操作系统文件
# =========================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# =========================
# 临时文件
# =========================
*.log
*.bak
*.tmp